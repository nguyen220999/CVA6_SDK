/dts-v1/;

/ {
	description = "NPU firmware FIT";
	#address-cells = <1>;

	images {
		npu-fw {
			description = "Neuron Processor firmware";
			data = /incbin/("npu_fw.bin");
			type = "firmware";
			arch = "riscv";
			os = "invalid";
			compression = "none";

			load = <0x84000000>;
			entry = <0x84000000>;

			hash-1 {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf-1";

		conf-1 {
			description = "NPU firmware configuration";
			firmware = "npu-fw";
		};
	};
};