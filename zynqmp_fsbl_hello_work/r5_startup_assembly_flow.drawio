          <mxGeometry x="250" y="25" width="1300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="vt" value="&lt;b&gt;_vector_table (.vectors)&lt;/b&gt;&lt;br&gt;8 entries × 4 bytes = 32 bytes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#4B5563;fontSize=15;fontStyle=1;" vertex="1" parent="21">
          <mxGeometry x="680" y="120" width="440" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="vreset" value="0x00 RESET&lt;br&gt;&lt;b&gt;ldr pc, =_boot&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="21"><mxGeometry x="90" y="285" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="vundef" value="0x04 UNDEFINED&lt;br&gt;ldr pc, =Undefined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="21"><mxGeometry x="310" y="285" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="vsvc" value="0x08 SVC/SWI&lt;br&gt;ldr pc, =SVCHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="21"><mxGeometry x="530" y="285" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="vpref" value="0x0C PREFETCH ABORT&lt;br&gt;ldr pc, =PrefetchAbortHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="21"><mxGeometry x="750" y="285" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="vdata" value="0x10 DATA ABORT&lt;br&gt;ldr pc, =DataAbortHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="21"><mxGeometry x="990" y="285" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="vres" value="0x14 RESERVED&lt;br&gt;NOP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="21"><mxGeometry x="1220" y="285" width="170" height="75" as="geometry"/></mxCell>
        <mxCell id="virq" value="0x18 IRQ&lt;br&gt;ldr pc, =IRQHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="21"><mxGeometry x="1420" y="285" width="170" height="75" as="geometry"/></mxCell>
        <mxCell id="vfiq" value="0x1C FIQ&lt;br&gt;ldr pc, =FIQHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="21"><mxGeometry x="1610" y="285" width="160" height="75" as="geometry"/></mxCell>

        <mxCell id="hreset" value="Đi vào boot.S&lt;br&gt;startup chính" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="21"><mxGeometry x="95" y="450" width="180" height="65" as="geometry"/></mxCell>
        <mxCell id="hundef" value="Push r0-r3,r12,lr&lt;br&gt;Fault PC = lr - 4&lt;br&gt;UndefinedException()&lt;br&gt;Restore → movs pc,lr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="21"><mxGeometry x="300" y="430" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="hsvc" value="Push context&lt;br&gt;Decode SWI immediate:&lt;br&gt;Thumb [lr-2] / ARM [lr-4]&lt;br&gt;SWInterrupt()&lt;br&gt;Restore → movs pc,lr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="21"><mxGeometry x="520" y="425" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="hpref" value="Push context&lt;br&gt;Fault PC = lr - 4&lt;br&gt;PrefetchAbortInterrupt()&lt;br&gt;Restore → subs pc,lr,#4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="21"><mxGeometry x="750" y="430" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="hdata" value="Push context&lt;br&gt;Fault PC = lr - 8&lt;br&gt;DataAbortInterrupt()&lt;br&gt;Restore → subs pc,lr,#8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="21"><mxGeometry x="985" y="430" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="hres" value="Không handler" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" vertex="1" parent="21"><mxGeometry x="1225" y="450" width="160" height="65" as="geometry"/></mxCell>
        <mxCell id="hirq" value="Push r0-r3,r12,lr&lt;br&gt;Nếu hard-float: save d0-d7,&lt;br&gt;FPSCR, FPEXC&lt;br&gt;IRQInterrupt()&lt;br&gt;Restore → subs pc,lr,#4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;" vertex="1" parent="21"><mxGeometry x="1400" y="420" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="hfiq" value="Push r0-r3,r12,lr&lt;br&gt;FIQInterrupt()&lt;br&gt;Restore → subs pc,lr,#4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="21"><mxGeometry x="1615" y="435" width="160" height="95" as="geometry"/></mxCell>

        <mxCell id="dispatch" value="&lt;b&gt;Các symbol *Interrupt là C-level dispatchers của BSP&lt;/b&gt;&lt;br&gt;Sau khi FSBL gọi XFsbl_RegisterHandlers(), dispatcher trỏ đến:&lt;br&gt;XFsbl_UndefHandler / SvcHandler / PreFetchAbortHandler / DataAbortHandler / IrqHandler / FiqHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=center;" vertex="1" parent="21">
          <mxGeometry x="330" y="650" width="1140" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="mode" value="&lt;b&gt;Mode switch do phần cứng Cortex-R5 thực hiện&lt;/b&gt;&lt;br&gt;Exception xảy ra → CPSR mode đổi → SP/LR banked tương ứng được dùng → vector entry → assembly wrapper → C handler → exception return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="21">
          <mxGeometry x="420" y="850" width="960" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="loc" value="&lt;b&gt;Vector location&lt;/b&gt;&lt;br&gt;LOVEC: 0x00000000 khi SCTLR.V=0&lt;br&gt;HIGHVEC: 0xFFFF0000 khi SCTLR.V=1&lt;br&gt;FSBL R5 tạm chuyển HIGHVEC khi nạp application đè vùng vector ở TCM 0x0." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="21">
          <mxGeometry x="540" y="1040" width="720" height="130" as="geometry"/>
        </mxCell>

