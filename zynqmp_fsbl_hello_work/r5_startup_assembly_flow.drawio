        </mxCell>
        <mxCell id="subtitle" value="Luồng thực tế của BSP standalone Cortex-R5: asm_vectors.S → boot.S → xil-crt0.S → xfsbl_main.c" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="1240" height="30" as="geometry"/>
        </mxCell>

        <!-- Phase backgrounds -->
        <mxCell id="p_vector" value="&lt;b&gt;1. RESET VECTOR&lt;/b&gt;" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;fillColor=#E5E7EB;strokeColor=#4B5563;fontColor=#374151;fontSize=15;swimlaneFillColor=#FAFAFA;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="800" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p_boot" value="&lt;b&gt;2. boot.S — PROCESSOR MINIMUM INITIALIZATION&lt;/b&gt;" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F4E79;fontSize=15;swimlaneFillColor=#F5F9FE;" vertex="1" parent="1">
          <mxGeometry x="250" y="430" width="1060" height="1320" as="geometry"/>
        </mxCell>
        <mxCell id="p_crt" value="&lt;b&gt;3. xil-crt0.S — C RUNTIME STARTUP&lt;/b&gt;" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2E6B32;fontSize=15;swimlaneFillColor=#F5FAF4;" vertex="1" parent="1">
          <mxGeometry x="380" y="1780" width="800" height="710" as="geometry"/>
        </mxCell>
        <mxCell id="notes_bg" value="&lt;b&gt;CONTEXT / REGISTER EFFECTS&lt;/b&gt;" style="swimlane;html=1;startSize=38;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7A4E00;fontSize=14;swimlaneFillColor=#FFFDF5;" vertex="1" parent="1">
          <mxGeometry x="1350" y="130" width="590" height="2360" as="geometry"/>
        </mxCell>

        <!-- Reset vector -->
        <mxCell id="reset" value="R5 reset / BootROM handoff" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#4B5563;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="205" width="240" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="vector" value="&lt;b&gt;_vector_table&lt;/b&gt;&lt;br&gt;ldr pc, =_boot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="195" width="270" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="linker" value="Linker script&lt;br&gt;&lt;b&gt;ENTRY(_vector_table)&lt;/b&gt;&lt;br&gt;.vectors được KEEP ở đầu image" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="200" width="470" height="110" as="geometry"/>
        </mxCell>

        <!-- boot.S -->
        <mxCell id="boot" value="&lt;b&gt;_prestart / _boot / OKToRun&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="615" y="485" width="330" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="zero_gpr" value="Zero general registers&lt;br&gt;&lt;b&gt;mov r0…r12, #0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="625" y="585" width="310" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="banked_stack" value="&lt;b&gt;Khởi tạo banked SP/LR&lt;/b&gt;&lt;br&gt;IRQ (0x12) → __irq_stack&lt;br&gt;SVC (0x13) → __supervisor_stack&lt;br&gt;ABT (0x17) → __abort_stack&lt;br&gt;FIQ (0x11) → __fiq_stack&lt;br&gt;UND (0x1B) → __undef_stack&lt;br&gt;SYS (0x1F) → __stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="525" y="690" width="510" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="fpu" value="Enable VFP&lt;br&gt;CPACR.CP10/CP11 = full access&lt;br&gt;FPEXC.EN = 1&lt;br&gt;Zero d0…d15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="905" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="disable" value="&lt;b&gt;Disable MPU + caches&lt;/b&gt;&lt;br&gt;SCTLR.M = 0, C = 0, I = 0&lt;br&gt;DSB → MCR → ISB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="1045" width="380" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="actlr" value="Cấu hình ACTLR khi cache/MPU đang tắt&lt;br&gt;• Tắt branch predictor + return stack tạm thời&lt;br&gt;• Enable ATCM/B0TCM/B1TCM ECC check&lt;br&gt;• Abort khi parity error&lt;br&gt;• Invalidate toàn bộ I-cache + D-cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="505" y="1180" width="550" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="lockstep_check" value="Lockstep &amp;&amp;&lt;br&gt;non-JTAG &amp;&amp;&lt;br&gt;LOCKSTEP_MODE_DEBUG=0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="1350" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="fault_log" value="Reset R5 debug logic&lt;br&gt;RPU_ERR_INJ |= 0x101&lt;br&gt;&lt;b&gt;Enable lockstep fault log&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="1370" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="init_mpu" value="&lt;b&gt;bl Init_MPU&lt;/b&gt;&lt;br&gt;Disable old MPU regions&lt;br&gt;Program TCM/DDR/PL/QSPI/device regions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="1515" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="enable" value="Enable branch predictor + return stack&lt;br&gt;ACTLR.DBWR = 1 (errata 780125)&lt;br&gt;&lt;b&gt;SCTLR.M/C/I = 1 → MPU + D/I cache ON&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="565" y="1640" width="430" height="90" as="geometry"/>
        </mxCell>

        <!-- boot side branch: vector location and abort -->
        <mxCell id="vec_mode" value="VEC_TABLE_IN_OCM?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1375" y="1390" width="250" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="lovec" value="Không define:&lt;br&gt;Clear SCTLR.V&lt;br&gt;Clear RPU_0_CFG.VINITHI&lt;br&gt;&lt;b&gt;Vector tại LOVEC / TCM 0x0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1395" width="250" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="ocmvec" value="Có define:&lt;br&gt;Giữ vector mapping theo OCM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1450" y="1560" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="async_abort" value="Enable asynchronous abort&lt;br&gt;&lt;b&gt;CPSR.A = 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1680" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- CRT0 -->
        <mxCell id="startup" value="&lt;b&gt;b _startup&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="1835" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cpu_init" value="&lt;b&gt;bl __cpu_init&lt;/b&gt;&lt;br&gt;BSP CPU initialization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="1925" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="warm" value="Warm reset?&lt;br&gt;RPU_PWRCTL bit 0 = 1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="2030" width="240" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="clear_bss" value="Cold boot:&lt;br&gt;Zero .sbss&lt;br&gt;Zero .bss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="2050" width="210" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="runtime" value="Set SYS SP = __stack&lt;br&gt;Start TTC timer nếu cần&lt;br&gt;Xil_InitializeExistingMPURegConfig()&lt;br&gt;__libc_init_array()&lt;br&gt;r0 = argc = 0; r1 = argv = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="2185" width="480" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="main" value="&lt;b&gt;bl main&lt;/b&gt;&lt;br&gt;xfsbl_main.c → STAGE 1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="2350" width="280" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="return" value="Nếu main return:&lt;br&gt;__libc_fini_array() → exit() → loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1380" y="2310" width="460" height="80" as="geometry"/>
        </mxCell>

        <!-- Context notes -->
        <mxCell id="cfg" value="&lt;b&gt;BSP R5 tìm thấy trên máy&lt;/b&gt;&lt;br&gt;XPAR_CPU_ID = 0&lt;br&gt;PROCESSOR_ACCESS_VALUE = 255&lt;br&gt;LOCKSTEP_MODE_DEBUG = 0&lt;br&gt;SLEEP_TIMER_BASEADDR = TTC9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="380" width="470" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="cpsr_note" value="&lt;b&gt;CPSR mode bits [4:0]&lt;/b&gt;&lt;br&gt;FIQ 0x11 | IRQ 0x12 | SVC 0x13&lt;br&gt;ABT 0x17 | UND 0x1B | SYS 0x1F&lt;br&gt;&lt;br&gt;Mỗi mode có banked SP/LR riêng. Nếu không khởi tạo, exception sớm có thể dùng stack rác." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="570" width="470" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="sctlr_note" value="&lt;b&gt;SCTLR bits được dùng&lt;/b&gt;&lt;br&gt;M bit 0: MPU&lt;br&gt;C bit 2: D-cache&lt;br&gt;I bit 12: I-cache&lt;br&gt;V bit 13: LOWVEC/HIGHVEC&lt;br&gt;&lt;br&gt;DSB/ISB bảo đảm đổi trạng thái có hiệu lực trước lệnh tiếp theo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="780" width="470" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="mpu_note" value="&lt;b&gt;Init_MPU() là C code trong section .boot&lt;/b&gt;&lt;br&gt;Startup assembly gọi nó trước khi bật SCTLR.M/C/I. Hàm tạo MPU regions cho TCM/DDR, PL, QSPI và vùng peripheral." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1030" width="470" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="warm_note" value="&lt;b&gt;Warm reset path&lt;/b&gt;&lt;br&gt;xil-crt0.S đọc MPIDR để chọn RPU_0_PWRCTL hoặc RPU_1_PWRCTL. Nếu bit 0 được set, bỏ qua zero .sbss/.bss để giữ context." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1880" width="470" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;Source đã đối chiếu&lt;/b&gt;&lt;br&gt;standalone_v8_0/src/arm/cortexr5/gcc/&lt;br&gt;• asm_vectors.S&lt;br&gt;• boot.S&lt;br&gt;• xil-crt0.S&lt;br&gt;và platform/ZynqMP/mpu.c" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="2100" width="470" height="145" as="geometry"/>
        </mxCell>

