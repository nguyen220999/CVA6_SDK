        <mxCell id="title" value="&lt;b&gt;CORTEX-R5 STARTUP ASSEMBLY FLOW — ZYNQMP FSBL&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1">
